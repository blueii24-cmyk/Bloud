# Bloud — Supabase connection (copy to .env.local for local dev).
# On Vercel these are set as project environment variables (Production + Preview).
# Get them from Supabase Dashboard → Project Settings → API.

VITE_SUPABASE_URL=https://gaewxsaaaraafyeltiiv.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Public Google OAuth Web client ID (the same client configured in Supabase Auth).
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
# Legacy fallback (either key works):
# VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# Runtime configuration for Vercel Drive API functions. A publishable/anon key is safe here;
# never put a Google OAuth client secret or Supabase service-role key in VITE_* variables.
SUPABASE_URL=https://gaewxsaaaraafyeltiiv.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Server-only (never expose in the browser). Used by scripts/seed.ts.
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...
